# The browser now talks to this app's own /api proxy, so it needs no gateway
# URL and no credential. These two are read server-side only.

# Where the proxy forwards to. NOT NEXT_PUBLIC_: the browser never sees it.
GATEWAY_ORIGIN=http://localhost:8000

# Attached by the proxy when a caller has no key of their own. Deliberately not
# NEXT_PUBLIC_, which would bake it into the client bundle (ADR-0019).
GATEWAY_DEMO_API_KEY=
