# Secure AI Gateway -- example environment.
# Copy to .env for local development. Never commit a real .env.
# Every value below is a non-production placeholder.

APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0

# Pepper mixed into API key hashing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_PEPPER=local-development-pepper-do-not-use-in-production

# Vault envelope encryption. VAULT_KEY_<KEY_ID> holds a base64 32-byte key.
# Generate with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
VAULT_ACTIVE_KEY_ID=local1
VAULT_KEY_LOCAL1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# HMAC key for audit correlation digests (base64 32 bytes).
AUDIT_HMAC_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Provider credentials. Leave empty locally: the mock provider is the default.
OPENAI_API_KEY=

# Observability. METRICS_TOKEN is the bearer credential a Prometheus scraper
# must present to GET /metrics. Left empty here, which leaves the endpoint open
# -- fine locally, and refused at startup when APP_ENV=production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_ENABLED=true
METRICS_TOKEN=

# Optional tuning
DEFAULT_SESSION_TTL_SECONDS=1800
MAX_REQUEST_BYTES=262144
MAX_MESSAGE_CHARS=32768
MAX_ENTITIES_PER_REQUEST=500
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=60
CORS_ALLOWED_ORIGINS=
