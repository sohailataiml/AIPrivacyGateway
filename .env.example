# Secure AI Gateway -- example environment.
# Copy to .env for local development. Never commit a real .env.
# Every value below is a non-production placeholder.

APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0

# Pepper mixed into API key hashing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_PEPPER=local-development-pepper-do-not-use-in-production

# Vault envelope encryption. VAULT_KEY_<KEY_ID> holds a base64 32-byte key.
# Generate with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
VAULT_ACTIVE_KEY_ID=local1
VAULT_KEY_LOCAL1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# HMAC key for audit correlation digests (base64 32 bytes).
AUDIT_HMAC_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Provider credentials. Leave empty locally: the mock provider is the default.
OPENAI_API_KEY=

# Observability. METRICS_TOKEN is the bearer credential a Prometheus scraper
# must present to GET /metrics. Left empty here, which leaves the endpoint open
# -- fine locally, and refused at startup when APP_ENV=production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_ENABLED=true
METRICS_TOKEN=

# Document storage (ADR-0020, ADR-0021, ADR-0027).
# The document key ring is separate from the vault's: session mappings expire in
# minutes and stored documents persist, so the two rotate independently. Generate
# a real key the same way as the vault key above.
DOCUMENTS_ENABLED=true
DOCUMENT_ACTIVE_KEY_ID=local1
DOCUMENT_KEY_LOCAL1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Document extraction (ADR-0028). Each document is parsed in its own spawned
# subprocess, so a hostile file that hangs, exhausts memory, or crashes a C
# extension takes out a worker rather than the gateway.
#
# EXTRACTION_MAX_WORKERS bounds how many run at once -- parsing is CPU-bound, so
# track available cores rather than expected traffic. EXTRACTION_TIMEOUT_SECONDS
# is a real deadline: the worker is terminated, not merely abandoned.
EXTRACTION_MAX_WORKERS=2
EXTRACTION_TIMEOUT_SECONDS=30
MAX_EXTRACTED_CHARACTERS=4000000

# Segmentation (ADR-0029). SEGMENT_OVERLAP_CHARACTERS is a privacy control, not
# a throughput knob: an entity shorter than the overlap is guaranteed to appear
# whole in at least one segment, and anything longer can be split across a
# boundary and seen only as fragments no recognizer matches. It must be smaller
# than SEGMENT_MAX_CHARACTERS or segmentation cannot advance.
SEGMENT_MAX_CHARACTERS=12000
SEGMENT_OVERLAP_CHARACTERS=256

# Detection over documents (ADR-0031). DOCUMENT_DETECTION_CONCURRENCY bounds how
# many segments are analyzed at once across every document in flight -- Presidio
# runs on a worker thread per call, so an unbounded fan-out over a long document
# starves the request path rather than finishing sooner.
#
# MAX_DOCUMENT_ENTITIES is deliberately not MAX_ENTITIES_PER_REQUEST. 500 is
# generous for a prompt and refuses an ordinary clinical document; this bound
# exists to stop one upload becoming an unbounded batch of vault writes, and it
# is the ceiling protection enforces too (ADR-0033).
DOCUMENT_DETECTION_CONCURRENCY=4
MAX_DOCUMENT_ENTITIES=10000

# S3-compatible object storage. Locally this is the MinIO service in
# docker-compose.yml; a deployment points at S3 and leaves the endpoint unset.
# Path-style addressing is what MinIO expects; AWS S3 prefers virtual-host.
OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=sgw-documents
OBJECT_STORE_ACCESS_KEY_ID=sgw-local-access-key
OBJECT_STORE_SECRET_ACCESS_KEY=sgw-local-secret-key-not-for-production
OBJECT_STORE_USE_PATH_STYLE=true

# Optional tuning
DEFAULT_SESSION_TTL_SECONDS=1800
MAX_DOCUMENT_BYTES=26214400
DOCUMENT_CHUNK_BYTES=5242880
MAX_REQUEST_BYTES=262144
MAX_MESSAGE_CHARS=32768
MAX_ENTITIES_PER_REQUEST=500
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=60
CORS_ALLOWED_ORIGINS=
