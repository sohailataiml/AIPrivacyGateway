# Copy to deploy.env, fill in real values, and run:
#   python -m scripts.check_deploy_config deploy.env
# deploy.env is gitignored. Delete it once the deploy is done.
#
# Generate the secrets with: python -m scripts.generate_deploy_secrets

API_KEY_PEPPER=
AUDIT_HMAC_KEY=
VAULT_ACTIVE_KEY_ID=prod1
VAULT_KEY_PROD1=
DOCUMENT_ACTIVE_KEY_ID=prod1
DOCUMENT_KEY_PROD1=
METRICS_TOKEN=

# The workspace's Render URL. A wildcard is refused in production.
CORS_ALLOWED_ORIGINS=https://sgw-workspace.onrender.com

# From Render once the services exist. Placeholders here are fine for the
# config check -- it validates shape and secrets, not reachability.
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
REDIS_URL=redis://host:6379/0

# AWS S3 (ADR-0035). No endpoint: S3 resolves its own, and production refuses
# a provider and an endpoint that disagree because that misconfiguration is
# otherwise silent -- it stores documents against whichever service botocore
# resolved.
#
# On a platform that can assume an AWS IAM role, leave both credentials blank
# and the role is used. Render cannot, so a Render deployment sets them.
OBJECT_STORE_PROVIDER=aws
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=sgw-documents
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=

DOCUMENTS_ENABLED=true
METRICS_ENABLED=true
DEFAULT_PROVIDER=mock
